# =============================================================================
# SiteFlow AI — Environment Configuration
# Copy this file to `.env` and adjust values for your local environment.
#   cp .env.example .env
#
# All values below are safe LOCAL DEVELOPMENT defaults. Never reuse them
# outside local development. Production deployments must supply strong secrets
# via their own environment (CI/CD secrets, secrets manager), never from git.
# =============================================================================

# ---- Application -------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000/api
CLIENT_URL=http://localhost:5173
LOG_LEVEL=info

# ---- Vite (client) -----------------------------------------------------------
# The client reads VITE_* variables from this repo-root .env file.
VITE_API_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000

# ---- PostgreSQL (operational database + pgvector) ----------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=siteflow
POSTGRES_USER=siteflow
POSTGRES_PASSWORD=siteflow_dev_password
# Optional full connection string. If set, it overrides the individual fields.
# POSTGRES_URL=postgresql://siteflow:siteflow_dev_password@127.0.0.1:5432/siteflow

# ---- Redis (cache, sessions, BullMQ, pub/sub, Socket.IO) ---------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=siteflow_dev_redis
# Optional full connection string. If set, it overrides host/port/password.
# REDIS_URL=redis://:siteflow_dev_redis@127.0.0.1:6379/0

# ---- S3-compatible object storage (MinIO locally, AWS S3 in production) ------
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=siteflow
S3_ACCESS_KEY=siteflow_minio
S3_SECRET_KEY=siteflow_minio_secret
S3_FORCE_PATH_STYLE=true

# ---- Auth (secrets required now for local/prod parity; used from Phase 1) ----
# NOTE: `docker compose up` (base file) runs the production-mode stack and the
# server refuses placeholder secrets when NODE_ENV=production. For that flow,
# set fresh values — generate with: openssl rand -hex 32
# Plain `npm run dev`/Vitest runs are non-production and accept the defaults.
JWT_ACCESS_SECRET=dev_only_access_secret_change_me
JWT_REFRESH_SECRET=dev_only_refresh_secret_change_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12