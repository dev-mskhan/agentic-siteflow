# Client environment variables.
#
# Vite reads VITE_* variables from the repository-root `.env` file (see
# `envDir: ".."` in vite.config.ts) OR from a local `client/.env`.
#
# If unset, the API client falls back to same-origin `/api` (used by the
# production Nginx container, which proxies /api and /health to the server).
VITE_API_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000