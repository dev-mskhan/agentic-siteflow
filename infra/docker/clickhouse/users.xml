<?xml version="1.0"?>
<!--
  ClickHouse users config.
  Default user has no password in local dev — fine for internal docker network only.
  Query limits live here in <profiles> — not in config.xml (ClickHouse 25.x strict validation).
-->
<clickhouse>
  <profiles>
    <default>
      <!-- Max query execution time: 60 seconds -->
      <max_execution_time>60</max_execution_time>
      <!-- Max memory per query: 2 GB -->
      <max_memory_usage>2000000000</max_memory_usage>
    </default>
  </profiles>

  <users>
    <default>
      <password></password>
      <networks>
        <ip>::/0</ip>
      </networks>
      <profile>default</profile>
      <quota>default</quota>
      <access_management>1</access_management>
    </default>
  </users>

  <quotas>
    <default>
      <interval>
        <duration>3600</duration>
        <queries>0</queries>
        <errors>0</errors>
        <result_rows>0</result_rows>
        <read_rows>0</read_rows>
        <execution_time>0</execution_time>
      </interval>
    </default>
  </quotas>
</clickhouse>
