# Copy to .env and fill in values
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
APP_URL=http://localhost:5173
DATABASE_URL=postgresql://siteflow:siteflow@127.0.0.1:5433/siteflow?schema=public&connection_limit=10&pool_timeout=10
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=dev-secret-change-me-in-production-32chars

# ── Observability (OpenTelemetry → SigNoz) ───────────────────────────────────
# Start SigNoz: docker compose --profile observability up -d
# Then visit: http://localhost:3301
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=siteflow-server
OTEL_SDK_DISABLED=false
