# Copy to .env and fill in values
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Frontend URL — used to build password reset and email verification links
APP_URL=http://localhost:5173
# Connection pool settings:
#   connection_limit: max connections per Prisma process
#                     formula: floor(postgres_max_connections / num_app_processes) - 5
#                     default postgres max_connections=100; with 1 process use 10
#   pool_timeout:    seconds to wait before throwing "connection pool timeout" (10s recommended)
DATABASE_URL=postgresql://siteflow:siteflow@localhost:5432/siteflow?schema=public&connection_limit=10&pool_timeout=10

# PgBouncer connection (for production multi-process deployments)
# Route application traffic through PgBouncer to avoid connection exhaustion
# DATABASE_URL_PGBOUNCER=postgresql://siteflow:siteflow@localhost:6432/siteflow?schema=public&connection_limit=10&pool_timeout=10&pgbouncer=true

# Direct connection bypasses PgBouncer — use for migrations (DDL not supported in transaction mode)
DATABASE_URL_DIRECT=postgresql://siteflow:siteflow@127.0.0.1:5433/siteflow?schema=public

REDIS_URL=redis://localhost:6379
# Redis memory limit is set at the infrastructure level via
# infra/docker/redis/redis.conf (maxmemory + volatile-lru policy).
# No application-level env var is required.

# Set to true when running multiple server instances behind a load balancer.
# All instances must share the same REDIS_URL.
# When true, a dedicated subscriber ioredis connection is created for Socket.IO pub/sub.
# Defaults to false (single-instance mode — no Redis pub/sub overhead).
REDIS_SOCKET_ADAPTER=false

# CORS — comma-separated list of allowed origins (used in production)
CORS_ORIGINS=http://localhost:3000

# Rate limiting (global, Redis-backed — keys stored under rl:global:*)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 32 characters
JWT_SECRET=change-me-in-production-must-be-at-least-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=siteflow-documents

# ── Email (Phase 8) ───────────────────────────────────────────────────────────
# Options: none | smtp | sendgrid
# Default is "none" — emails are logged at debug level but not sent
EMAIL_PROVIDER=none

# SMTP — use with Mailhog/Mailpit locally (docker-compose port 1025)
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
SMTP_FROM=noreply@siteflow.local

# SendGrid — requires axios peer dependency: pnpm add axios
# SENDGRID_API_KEY=SG.xxxx
# SENDGRID_FROM=noreply@yourdomain.com

# ── WhatsApp (Phase 8) ────────────────────────────────────────────────────────
# Options: none | meta | twilio
# Default is "none" — messages are logged at debug level but not sent
WHATSAPP_PROVIDER=none

# Meta WhatsApp Cloud API
# WHATSAPP_META_TOKEN=your-permanent-meta-token
# WHATSAPP_META_PHONE_NUMBER_ID=123456789012345
WHATSAPP_META_API_VERSION=v20.0

# Twilio WhatsApp (stub — install Twilio SDK separately to activate)
# WHATSAPP_TWILIO_ACCOUNT_SID=ACxxxxxxxx
# WHATSAPP_TWILIO_AUTH_TOKEN=xxxxxxxx
# WHATSAPP_TWILIO_FROM=+14155238886

# WhatsApp template name overrides (optional — defaults built into code)
# WHATSAPP_TEMPLATE_INVOICE_OVERDUE=siteflow_invoice_overdue
# WHATSAPP_TEMPLATE_TASK_ASSIGNED=siteflow_task_assigned
# (pattern: WHATSAPP_TEMPLATE_<NOTIFICATION_TYPE>)

# Per-tenant rate limiting (per organization, stacks on top of global limit)
TENANT_RATE_LIMIT_WINDOW_MS=60000
TENANT_RATE_LIMIT_MAX=1000

# Per-tenant BullMQ job concurrency
TENANT_JOB_CONCURRENCY_LIMIT=5
# BullMQ reliability defaults
QUEUE_DEFAULT_ATTEMPTS=5
QUEUE_BACKOFF_DELAY_MS=1000
QUEUE_BACKOFF_JITTER=0.3
QUEUE_DEFAULT_TIMEOUT_MS=60000
QUEUE_HIGH_COST_TIMEOUT_MS=600000
QUEUE_DEFAULT_CONCURRENCY=10
QUEUE_HIGH_COST_CONCURRENCY=2
QUEUE_COMPLETED_RETENTION_SECONDS=86400
QUEUE_FAILED_RETENTION_SECONDS=604800
