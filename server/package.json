{
  "name": "@siteflow/server",
  "version": "0.0.1",
  "private": true,
  "description": "SiteFlow AI — backend server",
  "type": "module",
  "main": "./dist/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed/index.ts",
    "build": "pnpm db:generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest --reporter=verbose",
    "dev": "node --watch --experimental-specifier-resolution=node --loader ts-node/esm src/server.ts",
    "start": "node dist/server.js",
    "clean": "rimraf dist"
  },
  "prisma": {
    "seed": "tsx prisma/seed/index.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.0",
    "@prisma/client": "6.10.1",
    "@trpc/server": "11.18.0",
    "bullmq": "5.56.1",
    "cors": "^2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "8.3.0",
    "ioredis": "5.6.1",
    "jsonwebtoken": "^9.0.3",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "uuid": "14.0.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "9.24.0",
    "@types/cors": "^2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "22.15.32",
    "@types/supertest": "7.2.1",
    "@types/uuid": "11.0.0",
    "eslint": "9.24.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.5.3",
    "prisma": "6.10.1",
    "rimraf": "6.0.1",
    "supertest": "7.2.2",
    "ts-node": "10.9.2",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.69.0",
    "vitest": "3.2.4"
  }
}
