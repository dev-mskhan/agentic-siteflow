// SiteFlow AI — Prisma schema
// Phase 1.1: Organizations, Users, OrganizationMembers

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Sentinel model — exists only so Prisma can generate a migration and client.
// Do NOT use this model in application business logic.
model SystemInfo {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())

  @@map("_system_info")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum OrgStatus {
  ACTIVE
  SUSPENDED
}

enum OrgRole {
  ADMIN
  MEMBER
  BILLING
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectRole {
  PROJECT_MANAGER
  FINANCE
  PROCUREMENT
  SITE_SUPERVISOR
  SUBCONTRACTOR
  CLIENT
  VIEWER
}

// ─── Identity Models ──────────────────────────────────────────────────────────

model Organization {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  plan      String    @default("free")
  status    OrgStatus @default(ACTIVE)
  settings  Json      @default("{}")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  members        OrganizationMember[]
  sessions       Session[]
  invitations    Invitation[]
  projects       Project[]
  projectMembers ProjectMember[]
  projectPhases  ProjectPhase[]
  costCodes      CostCode[]
  estimates      Estimate[]
  rateCards      RateCard[]
  laborRates     LaborRate[]

  @@map("organizations")
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified Boolean    @default(false)
  firstName     String
  lastName      String
  avatarUrl     String?
  passwordHash  String?    // Nullable to support future OAuth / SSO users
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  memberships              OrganizationMember[]
  sessions                 Session[]
  sentInvitations          Invitation[]         @relation("SentInvitations")
  createdProjects          Project[]            @relation("CreatedProjects")
  projectMemberships       ProjectMember[]
  createdEstimates         Estimate[]           @relation("CreatedEstimates")
  createdEstimateVersions  EstimateVersion[]    @relation("CreatedEstimateVersions")

  @@map("users")
}

model OrganizationMember {
  orgId     String
  userId    String
  role      OrgRole  @default(MEMBER)
  joinedAt  DateTime @default(now())
  invitedBy String?

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orgId, userId])
  @@map("organization_members")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  orgId        String
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())
  ipAddress    String?
  userAgent    String?
  isRevoked    Boolean  @default(false)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Invitation {
  id          String           @id @default(cuid())
  orgId       String
  email       String
  role        OrgRole          @default(MEMBER)
  token       String           @unique
  expiresAt   DateTime
  invitedById String
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())
  status      InvitationStatus @default(PENDING)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("SentInvitations", fields: [invitedById], references: [id])

  @@map("invitations")
}

model AuditLog {
  id        String   @id @default(cuid())
  orgId     String?
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([orgId])
  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ─── Project Models ───────────────────────────────────────────────────────────

model Project {
  id               String        @id @default(cuid())
  orgId            String
  name             String
  description      String?
  projectNumber    String?
  status           ProjectStatus @default(DRAFT)
  projectType      String?
  currency         String        @default("USD")
  clientName       String?
  clientContact    String?
  siteAddress      String?
  siteCity         String?
  siteCountry      String?
  contractValue    Decimal?      @db.Decimal(18, 4)
  contractDate     DateTime?
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?
  budget           Decimal?      @db.Decimal(18, 4)
  settings         Json          @default("{}")
  createdById      String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization    Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy       User            @relation("CreatedProjects", fields: [createdById], references: [id])
  members         ProjectMember[]
  phases          ProjectPhase[]
  projectSettings ProjectSettings?
  estimates       Estimate[]

  @@index([orgId])
  @@index([orgId, status])
  @@map("projects")
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  orgId     String
  role      ProjectRole
  addedById String?
  createdAt DateTime    @default(now())

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@index([orgId])
  @@map("project_members")
}

model ProjectSettings {
  id                        String   @id @default(cuid())
  projectId                 String   @unique
  currency                  String   @default("USD")
  currencySymbol            String   @default("$")
  timezone                  String   @default("UTC")
  dateFormat                String   @default("YYYY-MM-DD")
  unitSystem                String   @default("metric")
  country                   String   @default("US")
  taxRate                   Decimal  @default(0) @db.Decimal(5, 4)
  taxLabel                  String   @default("Tax")
  retainagePercent          Decimal  @default(0) @db.Decimal(5, 4)
  paymentTermsDays          Int      @default(30)
  requireChangeOrderApproval Boolean @default(true)
  requirePaymentApproval    Boolean  @default(true)
  customFields              Json     @default("{}")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_settings")
}

model ProjectPhase {
  id               String    @id @default(cuid())
  projectId        String
  orgId            String
  name             String
  description      String?
  color            String?
  order            Int       @default(0)
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?
  status           String    @default("ACTIVE")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  boqItems     BoqItem[]

  @@index([projectId])
  @@map("project_phases")
}

model CostCode {
  id          String   @id @default(cuid())
  orgId       String
  code        String
  name        String
  description String?
  category    String?
  parentId    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent       CostCode?    @relation("CostCodeHierarchy", fields: [parentId], references: [id])
  children     CostCode[]   @relation("CostCodeHierarchy")
  boqItems     BoqItem[]

  @@unique([orgId, code])
  @@index([orgId])
  @@map("cost_codes")
}

// ─── Pre-Construction Enums ───────────────────────────────────────────────────

enum EstimateStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  REJECTED
  CONVERTED
  ARCHIVED
}

// ─── Pre-Construction Models ──────────────────────────────────────────────────

model Estimate {
  id                 String         @id @default(cuid())
  orgId              String
  estimateNumber     String
  name               String
  description        String?
  status             EstimateStatus @default(DRAFT)
  version            Int            @default(1)
  clientName         String?
  clientContact      String?
  siteAddress        String?
  siteCity           String?
  siteCountry        String?
  currency           String         @default("USD")
  validUntil         DateTime?
  notes              String?
  scope              String?
  subtotal           Decimal        @default(0) @db.Decimal(18, 4)
  overhead           Decimal        @default(0) @db.Decimal(18, 4)
  contingency        Decimal        @default(0) @db.Decimal(18, 4)
  markup             Decimal        @default(0) @db.Decimal(18, 4)
  totalCost          Decimal        @default(0) @db.Decimal(18, 4)
  sellingPrice       Decimal        @default(0) @db.Decimal(18, 4)
  margin             Decimal        @default(0) @db.Decimal(5, 4)
  overheadPercent    Decimal        @default(0) @db.Decimal(5, 4)
  contingencyPercent Decimal        @default(0) @db.Decimal(5, 4)
  markupPercent      Decimal        @default(0) @db.Decimal(5, 4)
  projectId          String?
  createdById        String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy    User             @relation("CreatedEstimates", fields: [createdById], references: [id])
  project      Project?         @relation(fields: [projectId], references: [id])
  versions     EstimateVersion[]
  boqItems     BoqItem[]

  @@unique([orgId, estimateNumber])
  @@index([orgId])
  @@index([orgId, status])
  @@map("estimates")
}

model EstimateVersion {
  id          String   @id @default(cuid())
  estimateId  String
  orgId       String
  version     Int
  snapshot    Json
  changeNote  String?
  createdById String
  createdAt   DateTime @default(now())

  estimate  Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  createdBy User     @relation("CreatedEstimateVersions", fields: [createdById], references: [id])

  @@unique([estimateId, version])
  @@index([estimateId])
  @@map("estimate_versions")
}

model BoqItem {
  id                String   @id @default(cuid())
  estimateId        String
  orgId             String
  itemCode          String?
  description       String
  category          String?
  unit              String
  quantity          Decimal  @db.Decimal(18, 4)
  materialRate      Decimal  @default(0) @db.Decimal(18, 4)
  laborRate         Decimal  @default(0) @db.Decimal(18, 4)
  equipmentRate     Decimal  @default(0) @db.Decimal(18, 4)
  subcontractorRate Decimal  @default(0) @db.Decimal(18, 4)
  directCostRate    Decimal  @default(0) @db.Decimal(18, 4)
  directCostAmount  Decimal  @default(0) @db.Decimal(18, 4)
  markupPercent     Decimal  @default(0) @db.Decimal(5, 4)
  sellingRate       Decimal  @default(0) @db.Decimal(18, 4)
  amount            Decimal  @default(0) @db.Decimal(18, 4)
  phaseId           String?
  costCodeId        String?
  notes             String?
  order             Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  estimate  Estimate      @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  phase     ProjectPhase? @relation(fields: [phaseId], references: [id])
  costCode  CostCode?     @relation(fields: [costCodeId], references: [id])

  @@index([estimateId])
  @@index([orgId])
  @@map("boq_items")
}

model RateCard {
  id            String   @id @default(cuid())
  orgId         String
  name          String
  description   String?
  currency      String   @default("USD")
  isActive      Boolean  @default(true)
  effectiveDate DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  rateItems    RateCardItem[]

  @@index([orgId])
  @@map("rate_cards")
}

model RateCardItem {
  id          String   @id @default(cuid())
  rateCardId  String
  orgId       String
  type        String
  code        String?
  description String
  unit        String
  rate        Decimal  @db.Decimal(18, 4)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rateCard RateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)

  @@index([rateCardId])
  @@map("rate_card_items")
}

model LaborRate {
  id             String   @id @default(cuid())
  orgId          String
  classification String
  description    String?
  unit           String   @default("hr")
  rate           Decimal  @db.Decimal(18, 4)
  currency       String   @default("USD")
  isActive       Boolean  @default(true)
  effectiveDate  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, classification])
  @@index([orgId])
  @@map("labor_rates")
}
