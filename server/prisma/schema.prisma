// SiteFlow AI — Prisma schema
// Phase 0.2: datasource + generator + minimal sentinel model.
// Business domain models are added in Phase 1+.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Sentinel model — exists only so Prisma can generate a migration and client.
// Do NOT use this model in application business logic.
// Business domain tables are added in Phase 1+.
model SystemInfo {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())

  @@map("_system_info")
}
