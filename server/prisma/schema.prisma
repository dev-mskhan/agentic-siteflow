// SiteFlow AI — Prisma schema
// Phase 1.1: Organizations, Users, OrganizationMembers

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Sentinel model — exists only so Prisma can generate a migration and client.
// Do NOT use this model in application business logic.
model SystemInfo {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())

  @@map("_system_info")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum OrgStatus {
  ACTIVE
  SUSPENDED
}

enum OrgRole {
  ADMIN
  MEMBER
  BILLING
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectRole {
  PROJECT_MANAGER
  FINANCE
  PROCUREMENT
  SITE_SUPERVISOR
  SUBCONTRACTOR
  CLIENT
  VIEWER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  WONT_FIX
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SubcontractorStatus {
  ACTIVE
  INACTIVE
  PROSPECTIVE
  SUSPENDED
}

enum SubcontractorContractStatus {
  DRAFT
  ACTIVE
  COMPLETED
  TERMINATED
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  PREFERRED
  SUSPENDED
}

enum MaterialRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_FULFILLED
  FULFILLED
  REJECTED
  CANCELLED
}

enum MaterialRequestPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PurchaseOrderStatus {
  DRAFT
  ISSUED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum DeliveryStatus {
  SCHEDULED
  IN_TRANSIT
  DELIVERED
  PARTIALLY_RECEIVED
  REJECTED
  DELAYED
}

enum InventoryTransactionType {
  RECEIPT
  CONSUMPTION
  RETURN_TO_VENDOR
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
}

enum PartnerType {
  SUBCONTRACTOR
  VENDOR
}

// ─── Identity Models ──────────────────────────────────────────────────────────

model Organization {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  plan      String    @default("free")
  status    OrgStatus @default(ACTIVE)
  settings  Json      @default("{}")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  members           OrganizationMember[]
  sessions          Session[]
  invitations       Invitation[]
  projects          Project[]
  projectMembers    ProjectMember[]
  projectPhases     ProjectPhase[]
  costCodes         CostCode[]
  estimates         Estimate[]
  rateCards         RateCard[]
  laborRates        LaborRate[]
  tasks             Task[]
  taskHistory       TaskHistory[]
  taskDependencies  TaskDependency[]
  scheduleBaselines ScheduleBaseline[]
  taskDateChanges   TaskDateChange[]
  subcontractors    Subcontractor[]
  subcontractorContracts SubcontractorContract[]
  vendors           Vendor[]
  materials         Material[]
  materialRequests  MaterialRequest[]
  purchaseOrders    PurchaseOrder[]
  deliveries        Delivery[]
  inventoryTransactions InventoryTransaction[]
  partnerEvaluations    PartnerEvaluation[]

  @@map("organizations")
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified Boolean    @default(false)
  firstName     String
  lastName      String
  avatarUrl     String?
  passwordHash  String? // Nullable to support future OAuth / SSO users
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  memberships             OrganizationMember[]
  sessions                Session[]
  sentInvitations         Invitation[]         @relation("SentInvitations")
  createdProjects         Project[]            @relation("CreatedProjects")
  projectMemberships      ProjectMember[]
  createdEstimates        Estimate[]           @relation("CreatedEstimates")
  createdEstimateVersions EstimateVersion[]    @relation("CreatedEstimateVersions")
  assignedTasks           Task[]               @relation("AssignedTasks")
  createdTasks            Task[]               @relation("CreatedTasks")
  taskHistory             TaskHistory[]        @relation("ChangedTaskHistory")
  capturedBaselines       ScheduleBaseline[]   @relation("CapturedBaselines")
  taskDateChanges         TaskDateChange[]
  createdMilestones       Milestone[]          @relation("CreatedMilestones")
  createdDailyLogs        DailyLog[]            @relation("CreatedDailyLogs")
  responsibleIssues       Issue[]              @relation("ResponsibleIssues")
  createdIssues            Issue[]              @relation("CreatedIssues")
  createdSubcontractors   Subcontractor[]      @relation("CreatedSubcontractors")
  createdSubcontractorContracts SubcontractorContract[] @relation("CreatedSubcontractorContracts")
  createdVendors          Vendor[]             @relation("CreatedVendors")
  requestedMaterialRequests MaterialRequest[]  @relation("RequestedMaterialRequests")
  approvedMaterialRequests  MaterialRequest[]  @relation("ApprovedMaterialRequests")
  createdPurchaseOrders     PurchaseOrder[]    @relation("CreatedPurchaseOrders")
  approvedPurchaseOrders    PurchaseOrder[]    @relation("ApprovedPurchaseOrders")
  receivedDeliveries        Delivery[]         @relation("ReceivedDeliveries")
  performedInventoryTransactions InventoryTransaction[] @relation("PerformedInventoryTransactions")
  performedEvaluations      PartnerEvaluation[] @relation("PerformedPartnerEvaluations")

  @@map("users")
}

model OrganizationMember {
  orgId     String
  userId    String
  role      OrgRole  @default(MEMBER)
  joinedAt  DateTime @default(now())
  invitedBy String?

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orgId, userId])
  @@map("organization_members")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  orgId        String
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())
  ipAddress    String?
  userAgent    String?
  isRevoked    Boolean  @default(false)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Invitation {
  id          String           @id @default(cuid())
  orgId       String
  email       String
  role        OrgRole          @default(MEMBER)
  token       String           @unique
  expiresAt   DateTime
  invitedById String
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())
  status      InvitationStatus @default(PENDING)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("SentInvitations", fields: [invitedById], references: [id])

  @@map("invitations")
}

model AuditLog {
  id        String   @id @default(cuid())
  orgId     String?
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([orgId])
  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ─── Project Models ───────────────────────────────────────────────────────────

model Project {
  id               String        @id @default(cuid())
  orgId            String
  name             String
  description      String?
  projectNumber    String?
  status           ProjectStatus @default(DRAFT)
  projectType      String?
  currency         String        @default("USD")
  clientName       String?
  clientContact    String?
  siteAddress      String?
  siteCity         String?
  siteCountry      String?
  contractValue    Decimal?      @db.Decimal(18, 4)
  contractDate     DateTime?
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?
  budget           Decimal?      @db.Decimal(18, 4)
  settings         Json          @default("{}")
  createdById      String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization     Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy        User              @relation("CreatedProjects", fields: [createdById], references: [id])
  members          ProjectMember[]
  phases           ProjectPhase[]
  projectSettings  ProjectSettings?
  estimates        Estimate[]
  tasks            Task[]
  taskHistory      TaskHistory[]
  taskDependencies TaskDependency[]
  scheduleBaseline ScheduleBaseline?
  taskDateChanges  TaskDateChange[]
  milestones       Milestone[]
  dailyLogs        DailyLog[]
  issues            Issue[]
  subcontractorContracts SubcontractorContract[]
  materialRequests       MaterialRequest[]
  purchaseOrders         PurchaseOrder[]
  deliveries             Delivery[]
  inventoryTransactions  InventoryTransaction[]
  partnerEvaluations     PartnerEvaluation[]

  @@index([orgId])
  @@index([orgId, status])
  @@map("projects")
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  orgId     String
  role      ProjectRole
  addedById String?
  createdAt DateTime    @default(now())

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@index([orgId])
  @@map("project_members")
}

model ProjectSettings {
  id                         String   @id @default(cuid())
  projectId                  String   @unique
  currency                   String   @default("USD")
  currencySymbol             String   @default("$")
  timezone                   String   @default("UTC")
  dateFormat                 String   @default("YYYY-MM-DD")
  unitSystem                 String   @default("metric")
  country                    String   @default("US")
  taxRate                    Decimal  @default(0) @db.Decimal(5, 4)
  taxLabel                   String   @default("Tax")
  retainagePercent           Decimal  @default(0) @db.Decimal(5, 4)
  paymentTermsDays           Int      @default(30)
  requireChangeOrderApproval Boolean  @default(true)
  requirePaymentApproval     Boolean  @default(true)
  customFields               Json     @default("{}")
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_settings")
}

model Task {
  id               String       @id @default(cuid())
  projectId        String
  orgId            String
  phaseId          String?
  costCodeId       String?
  assigneeId       String?
  subcontractorId  String?
  name             String
  description      String?
  status           TaskStatus   @default(TODO)
  priority         TaskPriority @default(MEDIUM)
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?
  durationDays     Int?
  progress         Int          @default(0)
  notes            String?
  createdById      String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase        ProjectPhase?    @relation(fields: [phaseId], references: [id])
  costCode     CostCode?        @relation(fields: [costCodeId], references: [id])
  assignee     User?            @relation("AssignedTasks", fields: [assigneeId], references: [id])
  subcontractor Subcontractor?  @relation(fields: [subcontractorId], references: [id], onDelete: SetNull)
  createdBy    User             @relation("CreatedTasks", fields: [createdById], references: [id])
  history      TaskHistory[]
  dateChanges  TaskDateChange[]
  milestones   Milestone[] @relation("MilestoneLinkedTask")
  linkedIssues Issue[]     @relation("IssueLinkedTask")
  dependencies TaskDependency[] @relation("TaskPredecessors")
  dependents   TaskDependency[] @relation("TaskSuccessors")
  linkedMaterialRequestItems  MaterialRequestItem[]
  linkedPurchaseOrderItems    PurchaseOrderItem[]

  @@index([projectId])
  @@index([orgId])
  @@index([projectId, status])
  @@index([phaseId])
  @@index([subcontractorId])
  @@map("tasks")
}

model ScheduleBaseline {
  id            String   @id @default(cuid())
  projectId     String   @unique
  orgId         String
  name          String   @default("Original Baseline")
  capturedAt    DateTime @default(now())
  capturedById  String
  taskSnapshots Json
  createdAt     DateTime @default(now())

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  capturedBy   User         @relation("CapturedBaselines", fields: [capturedById], references: [id])

  @@index([projectId])
  @@index([orgId])
  @@map("schedule_baselines")
}

model TaskDateChange {
  id          String   @id @default(cuid())
  taskId      String
  projectId   String
  orgId       String
  field       String
  oldValue    String?
  newValue    String?
  reason      String
  changedById String
  changedAt   DateTime @default(now())

  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  changedBy    User         @relation(fields: [changedById], references: [id])

  @@index([taskId])
  @@index([projectId])
  @@index([orgId])
  @@map("task_date_changes")
}

model TaskHistory {
  id          String   @id @default(cuid())
  taskId      String
  projectId   String
  orgId       String
  field       String
  oldValue    String?
  newValue    String?
  changedById String
  changedAt   DateTime @default(now())

  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  changedBy    User         @relation("ChangedTaskHistory", fields: [changedById], references: [id])

  @@index([taskId])
  @@map("task_history")
}

model TaskDependency {
  id            String   @id @default(cuid())
  projectId     String
  orgId         String
  predecessorId String
  successorId   String
  type          String   @default("FS")
  lagDays       Int      @default(0)
  createdAt     DateTime @default(now())

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  predecessor  Task         @relation("TaskPredecessors", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor    Task         @relation("TaskSuccessors", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
  @@index([projectId])
  @@index([successorId])
  @@index([predecessorId])
  @@map("task_dependencies")
}

model ProjectPhase {
  id               String    @id @default(cuid())
  projectId        String
  orgId            String
  name             String
  description      String?
  color            String?
  order            Int       @default(0)
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?
  status           String    @default("ACTIVE")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  boqItems     BoqItem[]
  tasks        Task[]

  @@index([projectId])
  @@map("project_phases")
}

model CostCode {
  id          String   @id @default(cuid())
  orgId       String
  code        String
  name        String
  description String?
  category    String?
  parentId    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent       CostCode?    @relation("CostCodeHierarchy", fields: [parentId], references: [id])
  children     CostCode[]   @relation("CostCodeHierarchy")
  boqItems     BoqItem[]
  tasks        Task[]
  subcontractorContracts SubcontractorContract[]
  materials    Material[]
  linkedMaterialRequestItems MaterialRequestItem[]
  linkedPurchaseOrderItems   PurchaseOrderItem[]
  inventoryTransactions      InventoryTransaction[]

  @@unique([orgId, code])
  @@index([orgId])
  @@map("cost_codes")
}

// ─── Pre-Construction Enums ───────────────────────────────────────────────────

enum EstimateStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  REJECTED
  CONVERTED
  ARCHIVED
}

// ─── Pre-Construction Models ──────────────────────────────────────────────────

model Estimate {
  id                 String         @id @default(cuid())
  orgId              String
  estimateNumber     String
  name               String
  description        String?
  status             EstimateStatus @default(DRAFT)
  version            Int            @default(1)
  clientName         String?
  clientContact      String?
  siteAddress        String?
  siteCity           String?
  siteCountry        String?
  currency           String         @default("USD")
  validUntil         DateTime?
  notes              String?
  scope              String?
  subtotal           Decimal        @default(0) @db.Decimal(18, 4)
  overhead           Decimal        @default(0) @db.Decimal(18, 4)
  contingency        Decimal        @default(0) @db.Decimal(18, 4)
  markup             Decimal        @default(0) @db.Decimal(18, 4)
  totalCost          Decimal        @default(0) @db.Decimal(18, 4)
  sellingPrice       Decimal        @default(0) @db.Decimal(18, 4)
  margin             Decimal        @default(0) @db.Decimal(5, 4)
  overheadPercent    Decimal        @default(0) @db.Decimal(5, 4)
  contingencyPercent Decimal        @default(0) @db.Decimal(5, 4)
  markupPercent      Decimal        @default(0) @db.Decimal(5, 4)
  projectId          String?
  createdById        String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy    User              @relation("CreatedEstimates", fields: [createdById], references: [id])
  project      Project?          @relation(fields: [projectId], references: [id])
  versions     EstimateVersion[]
  boqItems     BoqItem[]

  @@unique([orgId, estimateNumber])
  @@index([orgId])
  @@index([orgId, status])
  @@map("estimates")
}

model EstimateVersion {
  id          String   @id @default(cuid())
  estimateId  String
  orgId       String
  version     Int
  snapshot    Json
  changeNote  String?
  createdById String
  createdAt   DateTime @default(now())

  estimate  Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  createdBy User     @relation("CreatedEstimateVersions", fields: [createdById], references: [id])

  @@unique([estimateId, version])
  @@index([estimateId])
  @@map("estimate_versions")
}

model BoqItem {
  id                String   @id @default(cuid())
  estimateId        String
  orgId             String
  itemCode          String?
  description       String
  category          String?
  unit              String
  quantity          Decimal  @db.Decimal(18, 4)
  materialRate      Decimal  @default(0) @db.Decimal(18, 4)
  laborRate         Decimal  @default(0) @db.Decimal(18, 4)
  equipmentRate     Decimal  @default(0) @db.Decimal(18, 4)
  subcontractorRate Decimal  @default(0) @db.Decimal(18, 4)
  directCostRate    Decimal  @default(0) @db.Decimal(18, 4)
  directCostAmount  Decimal  @default(0) @db.Decimal(18, 4)
  markupPercent     Decimal  @default(0) @db.Decimal(5, 4)
  sellingRate       Decimal  @default(0) @db.Decimal(18, 4)
  amount            Decimal  @default(0) @db.Decimal(18, 4)
  phaseId           String?
  costCodeId        String?
  notes             String?
  order             Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  estimate Estimate      @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  phase    ProjectPhase? @relation(fields: [phaseId], references: [id])
  costCode CostCode?     @relation(fields: [costCodeId], references: [id])
  linkedMaterialRequestItems MaterialRequestItem[]
  linkedPurchaseOrderItems   PurchaseOrderItem[]

  @@index([estimateId])
  @@index([orgId])
  @@map("boq_items")
}

model RateCard {
  id            String   @id @default(cuid())
  orgId         String
  name          String
  description   String?
  currency      String   @default("USD")
  isActive      Boolean  @default(true)
  effectiveDate DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  rateItems    RateCardItem[]

  @@index([orgId])
  @@map("rate_cards")
}

model RateCardItem {
  id          String   @id @default(cuid())
  rateCardId  String
  orgId       String
  type        String
  code        String?
  description String
  unit        String
  rate        Decimal  @db.Decimal(18, 4)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rateCard RateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)

  @@index([rateCardId])
  @@map("rate_card_items")
}

model LaborRate {
  id             String   @id @default(cuid())
  orgId          String
  classification String
  description    String?
  unit           String   @default("hr")
  rate           Decimal  @db.Decimal(18, 4)
  currency       String   @default("USD")
  isActive       Boolean  @default(true)
  effectiveDate  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, classification])
  @@index([orgId])
  @@map("labor_rates")
}

model Milestone {
  id           String   @id @default(cuid())
  projectId    String
  orgId        String
  name         String
  description  String?
  dueDate      DateTime
  status       String   @default("PENDING")
  linkedTaskId String?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  linkedTask Task?  @relation("MilestoneLinkedTask", fields: [linkedTaskId], references: [id], onDelete: SetNull)
  createdBy User    @relation("CreatedMilestones", fields: [createdById], references: [id])

  @@index([projectId])
  @@map("milestones")
}

model DailyLog {
  id                  String   @id @default(cuid())
  projectId           String
  orgId               String
  logDate             DateTime
  weather             String?
  temperature         Int?
  siteConditions      String?
  workerCount         Int?
  subcontractorCount  Int?
  equipmentNotes      String?
  workPerformed       String
  quantitiesCompleted Json?
  deliveries          Json?
  delays              Json?
  safetyEvents        Json?
  notes               String?
  createdById         String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("CreatedDailyLogs", fields: [createdById], references: [id])

  @@unique([projectId, logDate])
  @@index([projectId])
  @@map("daily_logs")
}

model Issue {
  id                     String        @id @default(cuid())
  projectId              String
  orgId                  String
  title                  String
  description            String
  category               String?
  priority               IssuePriority  @default(MEDIUM)
  status                 IssueStatus    @default(OPEN)
  responsiblePartyId     String?
  dueDate                DateTime?
  hasProjectImpact       Boolean       @default(false)
  projectImpactDescription String?
  hasCostImpact          Boolean       @default(false)
  costImpactAmount       Decimal?      @db.Decimal(18, 4)
  hasScheduleImpact      Boolean       @default(false)
  scheduleImpactDays     Int?
  resolution             String?
  resolvedAt             DateTime?
  linkedTaskId           String?
  createdById            String
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  project          Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  responsibleParty User?   @relation("ResponsibleIssues", fields: [responsiblePartyId], references: [id], onDelete: SetNull)
  linkedTask       Task?   @relation("IssueLinkedTask", fields: [linkedTaskId], references: [id], onDelete: SetNull)
  createdBy        User    @relation("CreatedIssues", fields: [createdById], references: [id])

  @@index([projectId])
  @@index([orgId])
  @@index([projectId, status])
  @@map("issues")
}

// ─── Phase 5: Partners & Procurement ──────────────────────────────────────────

model Subcontractor {
  id                    String              @id @default(cuid())
  orgId                 String
  companyName           String
  trade                 String
  contactName           String?
  contactEmail          String?
  contactPhone          String?
  address               String?
  taxId                 String?
  status                SubcontractorStatus @default(ACTIVE)
  licenseNumber         String?
  licenseExpiry         DateTime?
  insurancePolicyNumber String?
  insuranceExpiry       DateTime?
  isCompliant           Boolean             @default(true)
  rating                Decimal?            @db.Decimal(3, 2)
  notes                 String?
  createdById           String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  organization  Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy     User                    @relation("CreatedSubcontractors", fields: [createdById], references: [id])
  contracts     SubcontractorContract[]
  assignedTasks Task[]
  evaluations   PartnerEvaluation[]

  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, trade])
  @@map("subcontractors")
}

model SubcontractorContract {
  id               String                      @id @default(cuid())
  orgId            String
  projectId        String
  subcontractorId  String
  contractNumber   String
  scopeOfWork      String
  contractValue    Decimal                     @db.Decimal(18, 4)
  retainagePercent Decimal                     @default(0) @db.Decimal(5, 4)
  startDate        DateTime?
  endDate          DateTime?
  status           SubcontractorContractStatus @default(DRAFT)
  costCodeId       String?
  createdById      String
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  organization  Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subcontractor Subcontractor @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  costCode      CostCode?     @relation(fields: [costCodeId], references: [id])
  createdBy     User          @relation("CreatedSubcontractorContracts", fields: [createdById], references: [id])

  @@unique([orgId, contractNumber])
  @@index([projectId])
  @@index([subcontractorId])
  @@index([orgId])
  @@map("subcontractor_contracts")
}

model Vendor {
  id            String       @id @default(cuid())
  orgId         String
  vendorCode    String
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  city          String?
  country       String?
  taxId         String?
  paymentTerms  String?
  currency      String       @default("USD")
  status        VendorStatus @default(ACTIVE)
  rating        Decimal?     @db.Decimal(3, 2)
  notes         String?
  createdById   String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  organization  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy     User         @relation("CreatedVendors", fields: [createdById], references: [id])
  suppliedMaterials Material[] @relation("VendorMaterials")
  purchaseOrders    PurchaseOrder[]
  evaluations       PartnerEvaluation[]

  @@unique([orgId, vendorCode])
  @@index([orgId])
  @@index([orgId, status])
  @@map("vendors")
}

model Material {
  id                String    @id @default(cuid())
  orgId             String
  itemCode          String
  name              String
  description       String?
  category          String
  unit              String
  standardCost      Decimal   @default(0) @db.Decimal(18, 4)
  currency          String    @default("USD")
  preferredVendorId String?
  costCodeId        String?
  minStockLevel     Decimal?  @db.Decimal(18, 4)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  preferredVendor Vendor?      @relation("VendorMaterials", fields: [preferredVendorId], references: [id], onDelete: SetNull)
  costCode        CostCode?    @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  requestItems          MaterialRequestItem[]
  poItems               PurchaseOrderItem[]
  inventoryTransactions InventoryTransaction[]

  @@unique([orgId, itemCode])
  @@index([orgId])
  @@index([orgId, category])
  @@index([orgId, isActive])
  @@map("materials")
}

// ─── Procurement: Material Requests ───────────────────────────────────────────

model MaterialRequest {
  id               String                 @id @default(cuid())
  orgId            String
  projectId        String
  requestNumber    String
  title            String
  status           MaterialRequestStatus  @default(DRAFT)
  priority         MaterialRequestPriority @default(MEDIUM)
  neededByDate     DateTime
  deliveryLocation String?
  notes            String?
  requestedById    String
  approvedById     String?
  approvedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  organization   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy    User         @relation("RequestedMaterialRequests", fields: [requestedById], references: [id])
  approvedBy     User?        @relation("ApprovedMaterialRequests", fields: [approvedById], references: [id])
  items          MaterialRequestItem[]
  purchaseOrders PurchaseOrder[]

  @@unique([orgId, requestNumber])
  @@index([projectId])
  @@index([orgId, status])
  @@index([neededByDate])
  @@map("material_requests")
}

model MaterialRequestItem {
  id                String   @id @default(cuid())
  requestId         String
  materialId        String?
  description       String
  quantity          Decimal  @db.Decimal(18, 4)
  unit              String
  estimatedUnitCost Decimal? @db.Decimal(18, 4)
  fulfilledQuantity Decimal  @default(0) @db.Decimal(18, 4)
  costCodeId        String?
  linkedTaskId      String?
  linkedBoqItemId   String?
  createdAt         DateTime @default(now())

  request       MaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  material      Material?       @relation(fields: [materialId], references: [id], onDelete: SetNull)
  costCode      CostCode?       @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  linkedTask    Task?           @relation(fields: [linkedTaskId], references: [id], onDelete: SetNull)
  linkedBoqItem BoqItem?        @relation(fields: [linkedBoqItemId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@index([materialId])
  @@index([linkedTaskId])
  @@index([costCodeId])
  @@map("material_request_items")
}

// ─── Procurement: Purchase Orders ─────────────────────────────────────────────

model PurchaseOrder {
  id                  String              @id @default(cuid())
  orgId               String
  projectId           String
  vendorId            String
  poNumber            String
  status              PurchaseOrderStatus @default(DRAFT)
  issueDate           DateTime?
  expectedDeliveryDate DateTime?
  currency            String              @default("USD")
  subtotal            Decimal             @default(0) @db.Decimal(18, 4)
  taxRate             Decimal             @default(0) @db.Decimal(5, 4)
  taxAmount           Decimal             @default(0) @db.Decimal(18, 4)
  shippingAmount      Decimal             @default(0) @db.Decimal(18, 4)
  totalAmount         Decimal             @default(0) @db.Decimal(18, 4)
  paymentTerms        String?
  shippingAddress     String?
  notes               String?
  materialRequestId   String?
  createdById         String
  approvedById        String?
  approvedAt          DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  organization    Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor          Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  materialRequest MaterialRequest? @relation(fields: [materialRequestId], references: [id], onDelete: SetNull)
  createdBy       User             @relation("CreatedPurchaseOrders", fields: [createdById], references: [id])
  approvedBy      User?            @relation("ApprovedPurchaseOrders", fields: [approvedById], references: [id])
  items           PurchaseOrderItem[]
  deliveries      Delivery[]

  @@unique([orgId, poNumber])
  @@index([projectId])
  @@index([vendorId])
  @@index([orgId, status])
  @@index([expectedDeliveryDate])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String   @id @default(cuid())
  purchaseOrderId  String
  materialId       String?
  description      String
  quantity         Decimal  @db.Decimal(18, 4)
  unit             String
  unitPrice        Decimal  @db.Decimal(18, 4)
  totalPrice       Decimal  @db.Decimal(18, 4)
  receivedQuantity Decimal  @default(0) @db.Decimal(18, 4)
  costCodeId       String?
  linkedTaskId     String?
  linkedBoqItemId  String?
  createdAt        DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  material      Material?     @relation(fields: [materialId], references: [id], onDelete: SetNull)
  costCode      CostCode?     @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  linkedTask    Task?         @relation(fields: [linkedTaskId], references: [id], onDelete: SetNull)
  linkedBoqItem BoqItem?      @relation(fields: [linkedBoqItemId], references: [id], onDelete: SetNull)
  deliveryItems DeliveryReceiptItem[]

  @@index([purchaseOrderId])
  @@index([costCodeId])
  @@index([linkedTaskId])
  @@map("purchase_order_items")
}

// ─── Procurement: Deliveries and Receipts ─────────────────────────────────────

model Delivery {
  id                 String         @id @default(cuid())
  orgId              String
  projectId          String
  purchaseOrderId    String
  deliveryNumber     String
  deliveryNoteNumber String?
  carrier            String?
  trackingNumber     String?
  status             DeliveryStatus @default(SCHEDULED)
  expectedDate       DateTime
  actualDate         DateTime?
  isDelayed          Boolean        @default(false)
  delayedDays        Int            @default(0)
  delayReason        String?
  receivedById       String?
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization  Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  receivedBy    User?                 @relation("ReceivedDeliveries", fields: [receivedById], references: [id])
  receiptItems  DeliveryReceiptItem[]

  @@unique([orgId, deliveryNumber])
  @@index([purchaseOrderId])
  @@index([projectId])
  @@index([orgId, status])
  @@index([expectedDate])
  @@map("deliveries")
}

model DeliveryReceiptItem {
  id               String   @id @default(cuid())
  deliveryId       String
  poItemId         String
  quantityShipped  Decimal  @db.Decimal(18, 4)
  quantityReceived Decimal  @default(0) @db.Decimal(18, 4)
  quantityAccepted Decimal  @default(0) @db.Decimal(18, 4)
  quantityRejected Decimal  @default(0) @db.Decimal(18, 4)
  rejectionReason  String?
  notes            String?
  createdAt        DateTime @default(now())

  delivery Delivery          @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  poItem   PurchaseOrderItem @relation(fields: [poItemId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
  @@index([poItemId])
  @@map("delivery_receipt_items")
}

// ─── Procurement: Inventory Transactions ──────────────────────────────────────

model InventoryTransaction {
  id            String                   @id @default(cuid())
  orgId         String
  projectId     String
  materialId    String
  type          InventoryTransactionType
  quantity      Decimal                  @db.Decimal(18, 4)
  unit          String
  unitCost      Decimal?                 @db.Decimal(18, 4)
  totalCost     Decimal?                 @db.Decimal(18, 4)
  referenceType String?
  referenceId   String?
  costCodeId    String?
  notes         String?
  performedById String
  createdAt     DateTime                 @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  material     Material     @relation(fields: [materialId], references: [id], onDelete: Cascade)
  costCode     CostCode?    @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  performedBy  User         @relation("PerformedInventoryTransactions", fields: [performedById], references: [id])

  @@index([projectId, materialId])
  @@index([orgId])
  @@index([type])
  @@index([createdAt])
  @@map("inventory_transactions")
}

// ─── Subcontractors & Vendors: Partner Performance Evaluations ───────────────

model PartnerEvaluation {
  id                  String      @id @default(cuid())
  orgId               String
  partnerType         PartnerType
  subcontractorId     String?
  vendorId            String?
  projectId           String?
  evaluationDate      DateTime    @default(now())
  qualityRating       Int
  timelinessRating    Int
  communicationRating Int
  safetyRating        Int?
  overallRating       Decimal     @db.Decimal(3, 2)
  comments            String?
  evaluatorId         String
  createdAt           DateTime    @default(now())

  organization  Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subcontractor Subcontractor? @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  vendor        Vendor?        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evaluator     User           @relation("PerformedPartnerEvaluations", fields: [evaluatorId], references: [id])

  @@index([orgId, partnerType])
  @@index([subcontractorId])
  @@index([vendorId])
  @@index([projectId])
  @@map("partner_evaluations")
}




